from django.http import JsonResponse
from django.db.models import Q
from .models import Product

def product_search_api(request):
    # 1. 獲取前端透過 URL 傳過嚟嘅 search 參數
    query = request.GET.get('search', '').strip()
    
    if query:
        # 2. 使用 Q 進行 OR 查詢
        # name__icontains: 商品名稱包含關鍵字（不分大小寫）
        # tags__name__icontains: 透過 ManyToMany 關聯去搵 Tag 嘅名稱（不分大小寫）
        products = Product.objects.filter(
            Q(name__icontains=query) | 
            Q(tags__name__icontains=query)
        ).distinct()  # 🌟 必加 distinct()！避免因為一條商品有多個符合條件嘅 tag 而出現重複結果
    else:
        # 如果冇輸入任何嘢，就翻傳所有商品
        products = Product.objects.all()

    # 3. 將 QuerySet 轉換成 JSON 格式
    # 請根據你 Product Model 實際嘅 field 欄位名稱去修改 values() 入面嘅參數
    products_list = list(products.values('id', 'name', 'price', 'image_url'))
    
    return JsonResponse(products_list, safe=False)


